# Build the paper. Evaluation numbers are generated by running the reference
# implementation against the conformance corpus — never hand-edited.
#
#   make            # generate fragments, compile PDF, copy into public/paper/
#   make generated  # just the fragments
#   make pdf        # just the compile
#
# Requires: node, tectonic (https://tectonic-typesetting.github.io — single
# binary; `TECTONIC=/path/to/tectonic make` to point at a local download).

TECTONIC ?= tectonic
SITE_PDF = ../public/paper/live-verify-paper.pdf

# Reproducible output: pin the PDF's embedded timestamps (and \today) to the
# last commit touching paper/, so rebuilding without changes is a no-op in git.
export SOURCE_DATE_EPOCH := $(shell git log -1 --format=%ct -- .)

.PHONY: all generated pdf publish clean

all: publish

generated:
	node scripts/gen-conformance-table.js

pdf: generated
	$(TECTONIC) main.tex

publish: pdf
	mkdir -p ../public/paper
	cp main.pdf $(SITE_PDF)
	@echo "site copy: $(SITE_PDF)"

clean:
	rm -f main.pdf generated/*.tex
